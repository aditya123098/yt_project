# ─── Streamlit Cloud Secrets ─────────────────────────────────
# This file shows the format for Streamlit Cloud's "Secrets" section.
#
# HOW TO USE:
# 1. Go to your Streamlit Cloud app dashboard
# 2. Click on your app → Settings → Secrets
# 3. Paste the content below (with your real token)
#
# For local development, copy this file to:
#   .streamlit/secrets.toml   (remove the .example extension)
#
# Get your free token at: https://huggingface.co/settings/tokens
# ─────────────────────────────────────────────────────────────

HUGGINGFACEHUB_API_TOKEN = "hf_your_token_here"
